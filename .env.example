# ─────────────────────────────────────────────────────────────
#  Secretos del monitor Falabella (en GitHub van en Settings → Secrets and variables → Actions).
#  Para probar en local: copia este archivo como .env, complétalo y cárgalo antes de correr:
#      set -a; source .env; set +a; python -m tracker --dry-run -v
#  .env está en .gitignore: NUNCA se sube a GitHub.
# ─────────────────────────────────────────────────────────────

# Bot de Falabella (canal habitual)
TELEGRAM_TOKEN2=TU_TOKEN_DEL_BOT_FALABELLA
CHAT_ID2=TU_CHAT_ID_FALABELLA

# Bot 4 · OFERTAS BOMBA (opcional): recibe además, con foto, toda alerta con descuento > 69 %
# (desde -70%). Si se deja vacío, el monitor sigue igual sin reenviar.
TELEGRAM_TOKEN4=TU_TOKEN_DEL_BOT_4
CHAT_ID4=TU_CHAT_ID_BOT_4
